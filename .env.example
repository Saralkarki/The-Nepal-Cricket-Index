# Local development placeholders; do not use these values in production.
DJANGO_SECRET_KEY=replace-with-a-local-development-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DUCKDB_PATH=
# For Coolify, set DJANGO_SECURE_DEPLOYMENT=true, DJANGO_DEBUG=false,
# DJANGO_ALLOWED_HOSTS to the public hostname, and provide a unique secret
# through Coolify. Expose the app only through a trusted HTTPS proxy.
# If using the production Compose file, set CRICKET_DB_PATH to the absolute path
# of the manually copied database. Keep port 8000 private to the trusted proxy.
# For a Dockerfile-based Coolify deployment, mount the cricket database read-only
# at /app/data/nepal_cricket.db.
# Local development: docker compose -f compose.development.yaml up --build
# uses Dockerfile_development.
# Its image contains the local database and parquet data; do not publish it.
